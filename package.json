{
  "name": "veggie-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test --import=tsx tests/*.test.ts",
    "test:watch": "node --test --watch --import=tsx tests/*.test.ts",
    "db:seed": "npx tsx --env-file=.env.local prisma/seed.ts",
    "db:seed:events": "npx tsx --env-file=.env.local prisma/seed-events/index.ts",
    "db:seed:dispatch": "npx tsx --env-file=.env.local prisma/seed-events/seed-dispatch.ts",
    "db:seed:shortage-demo": "npx tsx --env-file=.env.local prisma/seed-events/seed-shortage-demo.ts",
    "db:validate": "npx tsx --env-file=.env.local scripts/validate-data.ts",
    "db:push": "npx dotenv -e .env.local prisma db push",
    "db:migrate": "npx dotenv -e .env.local prisma migrate deploy",
    "db:migrate:dev": "npx dotenv -e .env.local prisma migrate dev",
    "db:migrate:test": "npx dotenv -e .env.test prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "npx dotenv -e .env.local prisma studio",
    "images:fetch": "npx tsx --env-file=.env.local scripts/fetch-product-images.ts",
    "typecheck": "tsc --noEmit",
    "db:bootstrap": "npx tsx --env-file=.env.test scripts/db/bootstrap-fresh.ts",
    "db:opening-stock": "npx tsx --env-file=.env.test scripts/seed/ensure-opening-stock.ts",
    "test:print-matrix": "npx tsx --env-file=.env.test scripts/audit/print-matrix-test.ts",
    "test:portal-e2e": "npx tsx --env-file=.env.test scripts/audit/verify-portal-to-quotation.ts",
    "test:receipt-stock": "npx tsx --env-file=.env.test scripts/audit/receipt-stock-test.ts",
    "build:standalone": "next build && cp -R .next/static .next/standalone/.next/ && cp -R public .next/standalone/ 2>/dev/null || true",
    "test:print-status": "npx tsx --env-file=.env.test scripts/audit/print-status-test.ts",
    "test:pack-split": "npx tsx --env-file=.env.test scripts/audit/pack-split-print-test.ts",
    "test:print-filter": "npx tsx --env-file=.env.test scripts/audit/print-filter-test.ts",
    "test:shortage-bulk": "npx tsx --env-file=.env.test scripts/audit/shortage-bulk-test.ts",
    "test:daily-metrics": "npx tsx --env-file=.env.test scripts/audit/daily-metrics-test.ts",
    "db:sql-objects": "npx tsx --env-file=.env.test scripts/db/apply-sql-objects.ts",
    "test:loss-entry": "npx tsx --env-file=.env.test scripts/audit/loss-entry-test.ts",
    "test:receipt-linkage": "npx tsx --env-file=.env.test scripts/audit/receipt-linkage-test.ts",
    "test:purchase-suggestion": "npx tsx --env-file=.env.test scripts/audit/purchase-suggestion-test.ts",
    "test:pdf-extract": "npx tsx --env-file=.env.test scripts/audit/pdf-extract-test.ts",
    "test:purchase-lifecycle": "npx tsx --env-file=.env.test scripts/audit/purchase-lifecycle-test.ts",
    "test:uom-chain": "npx tsx --env-file=.env.test scripts/audit/uom-chain-test.ts",
    "test:purchase-qc": "npx tsx --env-file=.env.test scripts/audit/purchase-qc-test.ts",
    "test:statement": "npx tsx --env-file=.env.test scripts/audit/statement-settlement-test.ts",
    "test:vendor-settlement": "npx tsx --env-file=.env.test scripts/audit/vendor-settlement-test.ts",
    "test:reports-pivot": "npx tsx --env-file=.env.test scripts/audit/reports-pivot-test.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@base-ui/react": "^1.3.0",
    "@google-cloud/storage": "^7.15.2",
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-neon": "^7.7.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.7.0",
    "@sentry/nextjs": "^10.49.0",
    "@swc/helpers": "^0.5.21",
    "@types/leaflet": "^1.9.21",
    "@types/pdf-parse": "^1.1.5",
    "@types/ws": "^8.18.1",
    "@vis.gl/react-google-maps": "^1.8.3",
    "antd": "^6.3.5",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.2",
    "jsbarcode": "^3.12.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "next-intl": "^4.9.1",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "prisma": "^7.7.0",
    "puppeteer-core": "^24.43.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.1",
    "resend": "^6.12.0",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.20.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
