# Odoo 迁移脚本配置 —— 复制为 config.env 后填写真实值
# ⚠️ config.env 含连接信息/可能含密码，已被 .gitignore 忽略，绝不要提交。

# ===== SSH（连到原 Odoo 服务器；自建 VPS / Odoo.sh 场景）=====
SSH_HOST=your-server.example.com
SSH_USER=ubuntu
SSH_PORT=22

# ===== 源 PostgreSQL（在服务器上跑 dump 时通常是本机 socket）=====
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=odoo
PG_DB=odoo_prod
# 密码：优先用 ~/.pgpass 或交互输入；只在必要时填这里（别提交 config.env）
PG_PASSWORD=

# Odoo data_dir（filestore 的上一级；odoo.conf 里的 data_dir）
# 常见：/opt/odoo/.local/share/Odoo  或  /var/lib/odoo
DATA_DIR=/opt/odoo/.local/share/Odoo

# 服务器上存放 dump 的临时目录
REMOTE_WORKDIR=/tmp/odoo-export

# 本机接收目录
LOCAL_DIR=./odoo-backup

# dump 范围：full（全量，可完整恢复）| lean（全量结构，但剔除 mail/log/bus 等膨胀表的数据）
DUMP_SCOPE=lean

# 是否一并打包 filestore（图片/附件）：yes | no
INCLUDE_FILESTORE=yes

# 本机恢复成的库名
RESTORE_DB=odoo_restore

# ===== API 抽取（场景 C：只开放接口 / Odoo Online）=====
ODOO_URL=https://erp.example.com
ODOO_DB=odoo_prod
ODOO_USER=admin@example.com
ODOO_API_KEY=put-your-api-key-here
