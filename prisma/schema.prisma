generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OPERATOR
  RESTAURANT
  PICKER
  SORTER
  DRIVER
  BOSS
  FINANCE
  WAREHOUSE
  /// 正式销售（公司内部员工）
  SALES
  /// 外部合作销售 —— 权限比 SALES 更窄，且必须配合行级隔离（只看自己名下客户）
  EXTERNAL_SALES
  DISPATCH
  OTHER
}

enum ProductType {
  PRODUCT
  CONSU
  SERVICE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  WAVE_ASSIGNED
  IN_DELIVERY
  COMPLETED
  LOCKED // 锁定（开票后会计置此态，不可改）
  CANCELLED // 取消（客户撤销报价 / 业务员废弃）
}

/// 订单来源。在这之前无法区分「餐厅自助提交」与「业务员代下」——两者在列表页
/// 长得一模一样，来源只埋在 OrderAuditLog.changedFields.source 里，列表页够不着。
enum OrderSource {
  /// 客户在餐馆门户自助提交
  PORTAL
  /// 运营/业务员在后台创建（默认值：历史订单一律归此类，不做臆测性回溯）
  INTERNAL
  /// 从 Odoo 等外部系统批量导入
  IMPORT
}

enum PaymentMethod {
  ONLINE
  CASH
}

enum WaveStatus {
  PENDING
  PICKING
  PICKED
  SORTING
  SORTED
}

enum TripStatus {
  PENDING
  PENDING_ASSIGNMENT
  VERIFYING
  IN_PROGRESS
  COMPLETED
}

enum InvoiceStatus {
  DRAFT
  POSTED
  PAID
  CANCELLED
}

enum StockMoveType {
  IN
  OUT
  ADJUSTMENT
  RETURN
  SCRAP
}

enum UomType {
  /// 参考单位：每个 Category 必须有且只有一个
  REFERENCE
  /// 比参考单位小，factor < 1 (例如 g vs kg factor=0.001)
  SMALLER
  /// 比参考单位大，factor > 1 (例如 CASE of 10KG，factor=10)
  BIGGER
}

enum PurchaseOrderStatus {
  /// 询价单，尚未发出
  DRAFT
  /// 已发给供应商但未确认
  SENT
  /// 待审批（大额采购需老板确认）
  TO_APPROVE
  /// 供应商已确认接单
  CONFIRMED
  /// 已收货（全部或部分，通过 GoodsReceipt 追踪）
  RECEIVED
  /// 已收到供应商账单（VendorBill）
  INVOICED
  /// 已锁定（收货+开票完成，不可再编辑）
  LOCKED
  /// 取消
  CANCELLED
}

enum VendorBillStatus {
  DRAFT
  POSTED
  PAID
  CANCELLED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
  /// Accounts Receivable（应收）
  RECEIVABLE
  /// Accounts Payable（应付）
  PAYABLE
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  /// 主角色（兼容旧字段；权限判断优先看 roles[]，roles[] 为空时回退此字段）
  role         Role
  /// 多角色集合 — 一个账号可同时是 OPERATOR + SALES 等。
  /// 字符串数组（不是 enum 数组），值必须是 Role 枚举的字符串形式。
  roles        String[]  @default([])
  name         String
  customerId   String?
  isActive     Boolean   @default(true)
  /// MFA 秘钥（TOTP base32），为空表示未启用
  mfaSecret    String?
  mfaEnabled   Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  dailyReports DriverDailyReport[] @relation("DriverDailyReports")

  /// 直属上级。DataScope.TEAM 靠它算下属（只算一层，不做组织架构树）
  managerId          String?
  /// 权限版本号。权限变更时 bump，token 里的 pv 落后就强制重新登录
  permVersion        Int     @default(0)
  /// 必须先改密码才能用系统。导入脚本造出来的一批弱口令账号（test123）置 true，
  /// 登录后除了改密接口什么都调不了，改完自动清掉。见
  /// docs/20260807-production-credentials-audit.md
  mustChangePassword Boolean @default(false)

  manager      User?  @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates User[] @relation("UserManager")

  /// 可配置权限体系（20260807）
  roleLinks        UserRoleLink[]
  permissionGrants UserPermissionGrant[]

  /// 反向关系：该用户作为创建者的订单
  ordersCreated        Order[]         @relation("OrderCreator")
  /// 反向关系：该用户作为业务员的订单
  ordersAsSalesUser    Order[]         @relation("OrderSalesUser")
  /// 反向关系：该用户作为默认业务员的客户
  customersAsSalesUser Customer[]      @relation("CustomerSalesUser")
  /// 反向关系：绑定到该用户的司机配送批次(DriverSlot.userId)
  driverSlots          DriverSlot[]    @relation("DriverSlotUser")
  /// 反向关系：该用户作为负责人的采购品类分组
  categoryGroupsOwned  CategoryGroup[] @relation("CategoryGroupOwner")
  /// 反向关系：该用户发布的信息广场帖子
  bulletinPostsAuthored BulletinPost[] @relation("BulletinPostAuthor")
  /// 反向关系：该用户置顶的信息广场帖子
  bulletinPostsPinned   BulletinPost[] @relation("BulletinPostPinnedBy")

  @@index([role])
  @@index([customerId])
  @@index([isActive])
  @@index([managerId])
}

model ProductCategory {
  id             String            @id @default(cuid())
  name           String
  nameZh         String?
  externalId     String?           @unique
  /// 归属的采购品类分组（干货/日韩/超市/生鲜冷冻），可空=未映射
  groupId        String?
  group          CategoryGroup?    @relation(fields: [groupId], references: [id])
  /// 该类目商品业务上"应该"放哪个温区（业务规则），可空=未映射。与 Product.currentZoneId（实际放置）对比即可发现放错温区
  requiredZoneId String?
  requiredZone   Zone?             @relation("CategoryRequiredZone", fields: [requiredZoneId], references: [id])
  templates      ProductTemplate[]
  products       Product[]

  @@index([groupId])
  @@index([requiredZoneId])
}

enum ZoneKey {
  FROZEN
  CHILLED
  DRY
  AMBIENT
}

/// 仓库温区：冷冻区/冷藏区/常温干货区/常温超市区。
/// ProductCategory.requiredZoneId = 该类目商品业务上应放哪个温区；Product.currentZoneId = 该商品实际放在哪个温区（收货/上架时录入）。
/// 两者不一致即为"放错温区"，是仓库地图页温区不符检测的数据基础。
model Zone {
  id                   String            @id @default(cuid())
  key                  ZoneKey           @unique
  name                 String
  nameZh               String
  /// 温度区间说明，如 "-18°C 以下"，纯展示用
  tempRangeLabel       String?
  requiredByCategories ProductCategory[] @relation("CategoryRequiredZone")
  products             Product[]         @relation("ProductCurrentZone")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

enum CategoryGroupKey {
  DRY_GOODS
  JAPANESE_KOREAN
  SUPERMARKET
  FRESH_FROZEN
}

/// 采购品类分组：干货 / 日韩商品 / 超市商品 / 蔬菜生鲜冷冻。
/// 每组各自的采购节奏和负责人不同，是采购模块"一套流程,四套补货策略"的分组依据。
model CategoryGroup {
  id          String            @id @default(cuid())
  key         CategoryGroupKey  @unique
  name        String
  nameZh      String
  /// 补货节奏：DAILY(每日自动,生鲜) / PERIODIC(周期提醒,超市/日韩) / ANNUAL(年度计划,干货)
  cadence     String
  ownerUserId String?
  owner       User?             @relation("CategoryGroupOwner", fields: [ownerUserId], references: [id])
  categories  ProductCategory[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([ownerUserId])
}

model ProductAttribute {
  id       String                  @id @default(cuid())
  name     String
  sequence Int                     @default(0)
  values   ProductAttributeValue[]
}

model ProductAttributeValue {
  id          String           @id @default(cuid())
  name        String
  sequence    Int              @default(0)
  attributeId String
  attribute   ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@index([attributeId])
}

model ProductTemplate {
  id               String           @id @default(cuid())
  name             String
  internalRef      String?
  categoryId       String?
  category         ProductCategory? @relation(fields: [categoryId], references: [id])
  listPrice        Decimal          @default(0) @db.Decimal(12, 2)
  standardPrice    Decimal          @default(0) @db.Decimal(12, 2)
  customerTaxRate  Decimal          @default(0) @db.Decimal(6, 4)
  type             ProductType      @default(PRODUCT)
  canBeSold        Boolean          @default(true)
  canBePurchased   Boolean          @default(true)
  description      String?
  saleDescription  String?
  images           String[]
  attributeLines   Json             @default("[]")
  status           ProductStatus    @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  externalId       String?          @unique
  sequence         Int?
  weight           Decimal?         @db.Decimal(10, 3)
  /// 毛重（kg）。物流/报关/称重口径，独立于上面的"默认商品重量"weight。
  grossWeight      Decimal?         @db.Decimal(10, 3)
  /// 净重（kg）。物流/报关/称重口径，独立于上面的"默认商品重量"weight。
  netWeight        Decimal?         @db.Decimal(10, 3)
  volume           Decimal?         @db.Decimal(10, 3)
  commissionPrice  Decimal?         @db.Decimal(12, 2)
  isPackaging      Boolean?
  canBeExpensed    Boolean?
  /// 销售单位（Odoo uom_id）。新的外键字段，指向 Uom。
  uomId            String?
  uom              Uom?             @relation("SaleUom", fields: [uomId], references: [id])
  /// 采购单位（Odoo uom_po_id）
  purchaseUomId    String?
  purchaseUom      Uom?             @relation("PurchaseUom", fields: [purchaseUomId], references: [id])
  /// 兼容保留：老的 String 字段，逐步迁移到 uomId
  unitOfMeasure    String?
  purchaseUoM      String?
  tracking         String?
  websitePublished Boolean?
  websiteName      String?
  vendorTaxRate    Decimal?         @db.Decimal(6, 4)
  forecastQty      Decimal?         @db.Decimal(14, 3)
  createdBy        String?
  updatedBy        String?
  barcode          String?
  products         Product[]

  @@index([categoryId])
  @@index([sequence])
  @@index([status])
  @@index([uomId])
  @@index([purchaseUomId])
}

model Product {
  id                String                @id @default(cuid())
  templateId        String
  template          ProductTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name              String
  variantAttributes Json                  @default("[]")
  internalRef       String?
  listPrice         Decimal?              @db.Decimal(12, 2)
  standardPrice     Decimal?              @db.Decimal(12, 2)
  qtyOnHand         Decimal               @default(0) @db.Decimal(14, 3)
  active            Boolean               @default(true)
  categoryId        String?
  category          ProductCategory?      @relation(fields: [categoryId], references: [id])
  customerTaxRate   Decimal?              @db.Decimal(6, 4)
  commissionPrice   Decimal?              @db.Decimal(12, 2)
  images            String[]
  spec              String?
  price             Decimal?              @db.Decimal(12, 2)
  stock             Decimal?              @db.Decimal(14, 3)
  /// 安全库存下限（低于此值触发缺货预警）
  safetyStockMin    Decimal?              @default(0) @db.Decimal(14, 3)
  status            ProductStatus         @default(ACTIVE)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  externalId        String?               @unique
  sequence          Int?
  /// 该商品实际放在哪个温区（收货/上架时录入），可空=未上架定位。与 category.requiredZoneId 对比即可发现放错温区
  currentZoneId     String?
  currentZone       Zone?                 @relation("ProductCurrentZone", fields: [currentZoneId], references: [id])
  supplierInfos     ProductSupplierInfo[]
  orderLines        OrderLine[]
  lots              Lot[]
  saleUoms          ProductSaleUom[]
  aliases           ProductAlias[]

  @@index([templateId])
  @@index([categoryId])
  @@index([sequence])
  @@index([currentZoneId])
}

/**
 * 商品可售单位（大小单位灵活出单，20260714 新增；20260819 换算系数改挂商品）
 * ================================================================================
 * 一个商品可以挂多个可售单位（如 CASE 整箱 + PKT 拆零），共享同一份 Product.qtyOnHand。
 *
 * ## 换算系数为什么必须挂在**商品**上，而不是全局 Uom 上
 *
 * 20260819 生产库实测：`ASIAN CHOICE Black Tiger Shrimp 10*700g CASE` 与
 * `Chuannan Pickled Vegetable 30*62g CASE` 都叫 CASE，一箱一个装 10 包、一个装 30 包。
 * 「1 CASE 等于多少」根本不是 CASE 这个词的属性，而是**这个商品**的属性。
 * 全局 `Uom.factor` 承担不了 —— 生产库里 Unit 类目下的 factor 干脆全是 1，
 * 于是多规格报价形同虚设（切了单位价格不变、库存也不换算）。
 *
 * 所以 `factor` 落在这张表上：**1 个此单位 = factor 个基础单位**。
 * 基础单位就是 `isDefault = true` 那一行，其 factor 恒为 1。
 *
 * ## 库存口径（客户 20260819 拍板）
 *
 * `Product.qtyOnHand` 按**基础单位**（最小可售单位）计数。
 * 进 10 箱、每箱 10 包 → 库存记 100 包；卖 1 CASE 扣 10，卖 3 PKT 扣 3。
 * 这样拆箱散卖不需要任何人工调账 —— 而拆成两个商品的老办法（生产库有 67 组）
 * 必须靠人把 CASE 库存减 1、LOOSE 库存加 N，没人做，散装商品库存就长期是错的。
 *
 * `priceOverride` 留空则按「基础单价 × factor」自动换算，填了就用这个固定值
 * （整箱优惠价这类场景）。
 */
enum SaleUomPriceMode {
  AUTO     // 基准单价 × factor，四舍五入两位小数（现状默认行为）
  FIXED    // 直接用 priceOverride（现状"填了就固定"，只是显式建模成一个状态）
  FORMULA  // 基准单价 × factor × (1 − priceDiscountPct/100) + priceSurcharge
}

model ProductSaleUom {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  uomId         String
  uom           Uom      @relation(fields: [uomId], references: [id])
  /// 下单页默认选中的单位；一个商品应恰好有一个 isDefault=true（应用层保证，无数据库级约束）
  /// 它同时是**基础单位**：库存按它计数，其 factor 恒为 1
  isDefault     Boolean  @default(false)
  /// 1 个此单位 = factor 个基础单位。如 CASE 装 10 包则填 10；基础单位自身恒为 1。
  /// ⛔ 不要用全局 Uom.factor —— 同名 CASE 在不同商品里箱规不同（见 model 注释）
  /// ⛔ 精度必须够存"1/n"这类除不尽的小数（20260825 前只有 6 位小数，"÷3"存成
  ///    0.333333，页面反算 1/0.333333 显形成 3.000003——不是精度够用只是没显出来，
  ///    是反算会把截断误差放大）。10 位小数能让 n 到几万都反算干净。
  factor        Decimal  @default(1) @db.Decimal(18, 10)
  priceOverride Decimal? @db.Decimal(12, 2)
  /// 价格计算方式；默认 AUTO 与现状完全一致，存量数据据 priceOverride 是否有值一次性回填
  priceMode        SaleUomPriceMode @default(AUTO)
  /// FORMULA 模式下的折扣百分比，如 10 表示"打 9 折"
  priceDiscountPct Decimal          @default(0) @db.Decimal(6, 4)
  /// FORMULA 模式下的加减金额（可正可负），折扣之后再加
  priceSurcharge   Decimal          @default(0) @db.Decimal(12, 2)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([productId, uomId])
  @@index([productId])
  @@index([uomId])
}

model Customer {
  id                  String                 @id @default(cuid())
  name                String
  /// 兼容旧数据：合并后的整体地址（仍由后端自动维护，前端不直接编辑）
  address             String                 @default("")
  /// 街道 1（独立保存，不再与 street2 合并到 address）
  street              String                 @default("")
  /// 街道 2（Bug 修复 #3B：保存后保持独立字段，不再合并到 address）
  street2             String                 @default("")
  /// 州/省（拆分自旧的 address 字段）
  state               String                 @default("")
  /// 邮编
  zip                 String                 @default("")
  /// 国家（默认空，可在前端下拉选择）
  country             String                 @default("")
  phone               String                 @default("")
  email               String                 @default("")
  vatNumber           String                 @default("")
  paymentTerm         String                 @default("monthly")
  creditLimit         Decimal?               @db.Decimal(12, 2)
  /// 司机送货给此客户的佣金比率（0-1），例如 0.05 = 司机拿 5%
  commissionRate      Decimal?               @db.Decimal(6, 4)
  /// 司机送货给此客户的固定佣金（EUR / 单）
  commissionFixed     Decimal?               @db.Decimal(10, 2)
  createdAt           DateTime               @default(now())
  externalId          String?                @unique
  city                String?
  notes               String?
  /// 客户级外部备注（客户可见，打印在报价单/送货单上，如收货注意事项、结算方式）；与内部 notes 区分
  externalNote        String?
  /// 定价模式：multi=走价格表引擎, default=直接用牌价, last=用最近一次售价
  priceType           String                 @default("multi")
  isActive            Boolean                @default(true)
  /// 是否是客户（Odoo res.partner.is_customer）
  isCustomer          Boolean                @default(true)
  /// 是否是供应商（Odoo res.partner.is_vendor），两者可同时为 true
  isVendor            Boolean                @default(false)
  /// 供应商专属：采购税率
  vendorTaxRate       Decimal?               @db.Decimal(6, 4)
  /// 供应商专属：供应商付款条款
  supplierPaymentTerm String?
  /// 默认业务员用户 ID（下单时作为 Order.salesUserId 的默认来源）
  salesUserId         String?
  salesUser           User?                  @relation("CustomerSalesUser", fields: [salesUserId], references: [id], onDelete: SetNull)
  /// 经纬度（Google Geocoding API 填充）
  latitude            Float?
  longitude           Float?
  /// 默认配送批次（P1-4：客户↔司机绑定）
  defaultDriverSlotId String?
  defaultDriverSlot   DriverSlot?            @relation("CustomerDefaultSlot", fields: [defaultDriverSlotId], references: [id], onDelete: SetNull)
  specialPrices       CustomerSpecialPrice[]
  supplierInfos       ProductSupplierInfo[]  @relation("PartnerSupplierInfos")
  pricelists          CustomerPricelist[]
  contacts            CustomerContact[]

  @@index([isCustomer])
  @@index([isVendor])
  @@index([defaultDriverSlotId])
  @@index([salesUserId])
}

/**
 * 客户联系人（对应 Odoo res.partner 的子联系人 child_ids）
 * ================================================================================
 * 存在的理由：一个客户名下往往有多个人——下单的、对账的、收货的，各有各的邮箱。
 * 发报价单/销售单时要能选「主收件人 + 抄送若干」，而 `Customer.email` 只有一个格子。
 * ⚠️ 与 `Customer.email` 的关系：后者保留不动，作为「客户默认邮箱」继续被采购 RFQ 等
 * 既有逻辑使用。本表是**补充**不是替代——贸然把 Customer.email 迁走会牵动一堆只读它的地方。
 * 建表迁移会把非空的 Customer.email 回填成一条 isPrimary 联系人，两边初始是一致的。
 * `isPrimary` 每个客户至多一条，靠 partial unique index 保证（见迁移 SQL）——
 * Prisma schema 语法表达不了带 WHERE 的唯一索引，所以那句 DDL 是手写进迁移的，
 * 别指望 `prisma db push` 能从这里推导出来。
 */
model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  name       String
  email      String
  /// 职能标签，如「采购」「财务」「收货」。自由文本，不做枚举——
  /// 各家客户的叫法不一样，枚举只会逼出一堆 OTHER。
  role       String   @default("")
  phone      String   @default("")
  /// 默认收件人。发单据时默认选中它作为主收件人（To）
  isPrimary  Boolean  @default(false)
  isActive   Boolean  @default(true)
  /// Odoo res.partner 子联系人主键，供导入脚本幂等 upsert
  externalId String?  @unique
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([email])
}

/**
 * UoM Category（计量单位族，对应 Odoo uom.category）
 * ================================================================================
 * 同一 Category 内的单位可以互相换算（通过 reference 单位作为桥梁）。
 * 不同 Category 之间不能换算（例如"重量"和"体积"是独立的族）。
 */
model UomCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  nameZh    String?
  createdAt DateTime @default(now())
  uoms      Uom[]
}

/**
 * Unit of Measure（计量单位，对应 Odoo uom.uom）
 * ================================================================================
 * factor 表示"1 个本单位 = factor 个参考单位"。
 * 例如 Category="Weight" 参考单位 kg：
 * - kg: factor=1, type=REFERENCE
 * - g:  factor=0.001, type=SMALLER
 * - CASE (10kg BAG): factor=10, type=BIGGER
 * 换算公式：qty_in_ref = qty_in_uom × factor
 * qty_in_uom = qty_in_ref / factor
 */
model Uom {
  id         String      @id @default(cuid())
  name       String
  nameZh     String?
  categoryId String
  category   UomCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  type       UomType     @default(BIGGER)
  factor     Decimal     @default(1) @db.Decimal(14, 6)
  /// 四舍五入精度：订单数量会对齐到这个精度（如 0.01 表示两位小数）
  rounding   Decimal     @default(0.01) @db.Decimal(14, 6)
  /// 货物类型："BULK"（大货）/ "LOOSE"（散货）。司机备货分拣单按此分组。可空=未分类。
  goodsType  String?
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  saleTemplates     ProductTemplate[] @relation("SaleUom")
  purchaseTemplates ProductTemplate[] @relation("PurchaseUom")
  productSaleUoms   ProductSaleUom[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([active])
}

/**
 * 商品-供应商关联（Odoo product.supplierinfo）
 * 一个商品可以从多个供应商进货，每个供应商有自己的进货价、最小起订量、到货天数
 */
model ProductSupplierInfo {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    Customer  @relation("PartnerSupplierInfos", fields: [supplierId], references: [id], onDelete: Cascade)
  productCode String? // 供应商方的商品编码
  productName String? // 供应商方的商品名
  /// 采购单价（EUR）
  price       Decimal   @db.Decimal(12, 4)
  /// 最小起订量
  minQty      Decimal   @default(0) @db.Decimal(12, 4)
  /// 交货天数
  delay       Int       @default(1)
  /// 优先级：1=最优先（默认供应商），数字越小越优先
  sequence    Int       @default(10)
  dateStart   DateTime?
  dateEnd     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([productId, supplierId], name: "uniq_product_supplier")
  @@index([productId])
  @@index([supplierId])
}

/**
 * 采购单据识别的「原文 → 商品」记忆表（20260824 新增）
 * ================================================================================
 * 解决两个连在一起的问题：供应商单据上的商品名可能是西班牙语等系统匹配不上的写法，
 * 且同一份写法反复出现在多期单据里。与其做一次性通用翻译（不准、还要引外部 AI 服务），
 * 不如让操作员在核对界面选一次商品后就把这行原文记住 —— 下次同样的写法出现，
 * 直接精确命中，界面上也会显示当时选定的系统商品名（相当于变相"翻译"）。
 *
 * 全局生效，不分供应商：同一段原文不管出自哪家供应商的单据都指向同一个系统商品。
 */
model ProductAlias {
  id             String   @id @default(cuid())
  /// 单据上的原始文字，仅供人核对追溯，不参与匹配
  rawName        String
  /// normalizeName(rawName)：匹配时的唯一对照键
  normalizedName String   @unique
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([productId])
}

model CustomerSpecialPrice {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  minQty     Decimal  @default(0) @db.Decimal(14, 3)
  fixedPrice Decimal  @db.Decimal(12, 2)
  dateStart  String?
  dateEnd    String?
  note       String?

  @@index([customerId])
  @@index([productId])
}

model CustomerPricelist {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// 价格表 ID（不设 FK 约束，沿用 Customer.pricelistId 原有的宽松引用惯例：
  /// 允许指向暂不存在的价格表，pricing-engine 会回退牌价而不是报错）
  pricelistId String
  /// 数字越小优先级越高，1 = 最高优先级
  sequence    Int
  createdAt   DateTime @default(now())

  @@unique([customerId, pricelistId])
  @@index([customerId, sequence])
  @@index([pricelistId])
}

model OdooPricelist {
  id              String   @id @default(cuid())
  externalId      String?  @unique
  name            String
  currency        String   @default("EUR")
  items           Json     @default("[]")
  sequence        Int      @default(0)
  selectable      Boolean  @default(true)
  active          Boolean  @default(true)
  updatedAt       DateTime @updatedAt
  promotionalCode String?
  notes           String?
  website         String?
  countryGroups   Json     @default("[]")

  @@index([active])
  @@index([sequence])
}

model Order {
  id                    String        @id @default(cuid())
  /// 业务编号：创建者缩写-YYMMDD-NNN（如 CJ-260424-001），历史订单可为空
  code                  String?       @unique
  /// 创建者用户 ID（历史订单可为空）
  createdById           String?
  createdBy             User?         @relation("OrderCreator", fields: [createdById], references: [id])
  /// 创建者姓名快照（避免日后改名影响历史显示）
  createdByName         String?
  /// 下单渠道。默认 INTERNAL 保证加字段不破坏历史数据；门户下单处显式写 PORTAL。
  /// 历史订单只在 OrderAuditLog 留过痕，迁移里据此回填真正的门户单，其余不做臆测。
  source                OrderSource   @default(INTERNAL)
  restaurantId          String
  restaurantName        String
  items                 Json          @default("[]")
  totalAmount           Decimal       @default(0) @db.Decimal(12, 2)
  status                OrderStatus   @default(PENDING)
  paymentMethod         PaymentMethod @default(ONLINE)
  externalRef           String?       @unique
  createdAt             DateTime      @default(now())
  /// 下单时快照客户的价格表 ID（对应 Odoo sale.order.pricelist_id）
  pricelistId           String?
  /// 下单时快照客户的定价模式（multi/default/last）
  priceType             String?
  /// 订单级付款条件覆盖（如 monthly / cod），为空则沿用客户 Customer.paymentTerm 默认设置
  paymentTerm           String?
  /// 下单时快照司机佣金率（commissionRate）
  commissionRate        Decimal?      @db.Decimal(6, 4)
  /// 内部备注（仅内部可见，不打印在客户单据上）
  internalNote          String?
  /// 外部备注（打印在报价单/送货单上，客户可见）
  externalNote          String?
  /// 第三方送货备注（第三方替我们送货时的具体信息，打印在送货单上）
  deliveryNote          String?
  /// 业务员用户 ID（对应 Odoo sale.order.user_id）
  salesUserId           String?
  salesUser             User?         @relation("OrderSalesUser", fields: [salesUserId], references: [id], onDelete: SetNull)
  /// 报价日期（创建时自动设置）
  quotationDate         DateTime?
  /// 确认日期（确认时自动设置）
  confirmationDate      DateTime?
  /// 交货日期（手动选择）
  deliveryDate          DateTime?
  /// 发票日期（跟随交货日期，可手动覆盖）
  invoiceDate           DateTime?
  /// 送货单是否已回（司机送完货带回签收单，会计核销时标记）
  orderReturn           Boolean       @default(false)
  /// 配送批次+司机，格式 "1 am BAO" / "2 pm AFZAAL"（旧合并字段，逐步弃用）
  deliveryBatch         String?
  /// 关联 DriverSlot（拆分后的配送批次），替代 deliveryBatch 字符串
  driverSlotId          String?
  driverSlot            DriverSlot?   @relation(fields: [driverSlotId], references: [id])
  /// 报价单发送给客户的时间（PENDING + sentAt → "Quotation Sent" 子状态）
  sentAt                DateTime?
  /// 锁定时间（开票后置 LOCKED 状态时回填）
  lockedAt              DateTime?
  /// 最近一次打印时间（销售单打印追踪）
  printedAt             DateTime?
  /// 最近一次打印人用户 ID
  printedById           String?
  /// 最近一次打印人姓名快照
  printedByName         String?
  /// 最近一次打印的单据类型：DELIVERY | SALES
  printType             String?
  /// 累计打印次数
  printCount            Int           @default(0)
  /// 下单时快照客户的固定佣金（EUR / 单）
  commissionFixed       Decimal?      @db.Decimal(10, 2)
  /// 冻结后的司机提成总额（Trip 核实交账时写入，写入后不再随实时计算变动）
  driverCommissionTotal Decimal?      @db.Decimal(10, 2)
  /// 提成冻结时间（写入 driverCommissionTotal 时回填）
  commissionFrozenAt    DateTime?

  auditLogs     OrderAuditLog[]
  deliverySlip  DeliverySlip?
  lines         OrderLine[]
  discrepancies OrderDiscrepancy[]

  @@index([restaurantId])
  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@index([deliveryDate])
  @@index([pricelistId])
  @@index([createdById])
  @@index([driverSlotId])
  @@index([salesUserId])
  @@index([printedById])
}

/// 订单行（Odoo 对齐）— 每条记录对应一种商品的一行明细，含 ordered/delivered/invoiced 三个数量
model OrderLine {
  id                String    @id @default(cuid())
  orderId           String
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product?  @relation(fields: [productId], references: [id])
  productName       String
  spec              String?
  /// 行级备注（商品级 note，如"free"赠品/注意事项），下单时由操作员填写
  note              String?
  uomId             String?
  uomName           String?
  unitPrice         Decimal   @db.Decimal(12, 2)
  taxRate           Decimal?  @db.Decimal(6, 4)
  /// 报价/订购数量（quotation 保存时填）
  orderedQty        Decimal   @db.Decimal(14, 3)
  /// 已交货数量（Trip 标记送达时回写）
  deliveredQty      Decimal   @default(0) @db.Decimal(14, 3)
  /// 已开票数量（生成发票时回写，等于发票时的 deliveredQty）
  invoicedQty       Decimal   @default(0) @db.Decimal(14, 3)
  /// unitPrice × orderedQty 快照
  subtotal          Decimal   @db.Decimal(12, 2)
  /// 下单时快照该商品的件提成单价（来自 Product/ProductTemplate.commissionPrice）
  commissionPrice   Decimal?  @db.Decimal(10, 4)
  /// 单价来源快照（下单/编辑时计算，历史订单无此字段一律为 null）：
  /// PRICELIST=命中价格表 / DEFAULT=直接牌价 / LAST=最近成交价 / SPECIAL=客户专属价
  priceSourceType   String?
  /// 来源明细：PRICELIST 时为命中的价格表名字，其余情况为 null
  priceSourceDetail String?
  /// LAST 来源时，最近一次成交（订单创建）发生的时间
  priceSourceDate   DateTime?
  sequence          Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([uomId])
}

/// 拣货差异记录（拣货数量与下单数量不符时由运营记录）
model OrderDiscrepancy {
  id                    String    @id @default(cuid())
  /// 差异编号：DISC-00001
  code                  String    @unique
  orderId               String
  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderLineId           String
  productId             String
  productName           String
  /// 原始下单数量
  orderedQty            Decimal   @db.Decimal(14, 3)
  /// 实际拣货数量
  pickedQty             Decimal   @db.Decimal(14, 3)
  /// 差异数量（orderedQty - pickedQty，正数表示缺少）
  diffQty               Decimal   @db.Decimal(14, 3)
  /// 差异类型：SHORTAGE=缺货, SUBSTITUTE=替代, WEIGHT_DIFF=重量差异
  type                  String
  /// 处理状态：PENDING=待处理, RESOLVED=已处理, CANCELLED=已取消
  status                String    @default("PENDING")
  /// 处理方式：ADJUST_QTY=调整数量, SUBSTITUTE=替代商品, CANCEL_LINE=取消该行, REPLENISH=补货
  resolution            String?
  /// 替代商品 ID（当 resolution=SUBSTITUTE 时填写）
  substituteProductId   String?
  substituteProductName String?
  substituteQty         Decimal?  @db.Decimal(14, 3)
  substituteUnitPrice   Decimal?  @db.Decimal(12, 2)
  /// 运营备注
  note                  String?
  /// 上报人（拣货员）
  reportedBy            String?
  reportedByName        String?
  /// 处理人（运营）
  resolvedBy            String?
  resolvedByName        String?
  resolvedAt            DateTime?
  createdAt             DateTime  @default(now())

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@index([orderLineId])
  @@index([productId])
  @@index([substituteProductId])
}

/// 订单操作审计日志
model OrderAuditLog {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId        String
  action        String // created | confirmed | withdrawn | cancelled | updated
  changedFields Json?
  totalBefore   Decimal? @db.Decimal(12, 2)
  totalAfter    Decimal? @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
  @@index([userId])
}

/// 送货单（每张订单对应一张，确认订单时生成）
model DeliverySlip {
  id           String    @id @default(cuid())
  orderId      String    @unique
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId   String
  customerName String
  deliveryDate DateTime?
  createdAt    DateTime  @default(now())

  @@index([customerId])
  @@index([createdAt])
}

model PickingWave {
  id               String     @id @default(cuid())
  name             String?
  orderIds         String[]
  zones            Json       @default("[]")
  status           WaveStatus @default(PENDING)
  createdAt        DateTime   @default(now())
  waveDate         DateTime?  @db.Date
  waveNumber       Int?
  waveType         String?
  /// 历史遗留兼容字段：曾是"波次=单个批次号"时代的主键来源，现已不参与唯一性判定
  /// (一个波次现在可以跨多个 batchNum/DriverSlot)，仅在极少数兼容读路径里作兜底，不可再当 SSOT 用。
  driverSlotId     String?
  driverName       String?
  /// "am" | "pm"，与 driverName 同为快照字段；波次唯一性 = 司机+时段(不再按批次号拆分)
  timeOfDay        String?
  /// 分配完成标记时间：调度员点「分配完成」后回填，纯进度标记，可反悔；订单一变动即清空
  assignmentDoneAt DateTime?
  /// 确认出发时间：操作员点「确认出发」后回填，标记该批次已发车（防重复出发 + 追溯）
  dispatchedAt     DateTime?
  /// 标记完成时间：司机回仓后操作员点「标记完成」，卡片从调度台归档
  completedAt      DateTime?
  /// 拣货锁定时间：打印员打印拣货单后回填，锁定期间调度不可改该批次
  pickLockedAt     DateTime?
  /// 拣货锁定操作人
  pickLockedBy     String?
  /// 最近一次解锁时间，纯留痕
  pickUnlockedAt   DateTime?
  pallets          Pallet[]

  /// 注意：唯一性不是"永远只有一条"，而是"同一司机同一时段，未出发的波次只能有一条"——
  /// 已出发/已完成的历史波次允许并存(不回溯合并，见迁移策略)。这个偏序约束目前只在应用层
  /// (lib/wave-assign.ts assignOrderToWave)保证；数据库层的 partial unique index 要等历史重复
  /// 波次(现存的同司机同时段多条未出发波次)合并干净后再补，避免建索引时因存量脏数据直接失败。
  @@index([waveDate, driverName, timeOfDay])
  @@index([status])
  @@index([waveDate])
  @@index([driverSlotId])
  @@index([createdAt])
}

/// 托盘：司机车上的自由拼货容器，可跨餐馆混装，seq=卸货/装车顺序
model Pallet {
  id        String      @id @default(cuid())
  waveId    String
  wave      PickingWave @relation(fields: [waveId], references: [id], onDelete: Cascade)
  seq       Int
  label     String?
  /// [{ orderId, restaurantId, restaurantName, productId, productName, qty, uomName }]
  items     Json        @default("[]")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([waveId, seq])
  @@index([waveId])
}

model Trip {
  id               String     @id @default(cuid())
  /// 关联拣货波次（手动创建的行程可为空）
  waveId           String?
  /// 行程名称，如"上午 · 王师傅 · 4家餐馆"
  name             String?
  /// 配送时段：AM（上午）或 PM（下午）
  timeSlot         String?
  driverId         String?
  driverName       String?
  departTime       String?
  status           TripStatus @default(PENDING)
  restaurants      Json       @default("[]")
  totalPayment     Decimal    @default(0) @db.Decimal(12, 2)
  /// 本次配送司机总佣金（按每家客户 commissionRate × subtotal 累加）
  driverCommission Decimal?   @db.Decimal(12, 2)
  /// 司机交账：现金收款金额（P1-10）
  cashCollected    Decimal?   @default(0) @db.Decimal(12, 2)
  /// 司机交账：在线收款金额
  onlineCollected  Decimal?   @default(0) @db.Decimal(12, 2)
  /// 交账状态：pending | submitted | confirmed
  settlementStatus String?    @default("pending")
  /// 交账确认时间
  settledAt        DateTime?
  /// 交账确认人
  settledBy        String?
  /// 交账备注
  settlementNote   String?
  createdAt        DateTime   @default(now())

  @@index([driverId])
  @@index([status])
  @@index([waveId])
  @@index([timeSlot])
  @@index([settlementStatus])
}

model Invoice {
  id            String        @id @default(cuid())
  name          String
  customerId    String
  customerName  String
  saleOrderIds  String[]
  lines         Json          @default("[]")
  subtotalExTax Decimal       @default(0) @db.Decimal(12, 2)
  totalTax      Decimal       @default(0) @db.Decimal(12, 2)
  totalIncTax   Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  amountDue     Decimal       @default(0) @db.Decimal(12, 2)
  status        InvoiceStatus @default(DRAFT)
  paymentTerms  String        @default("monthly")
  dueDate       String?
  createdAt     DateTime      @default(now())
  postedAt      String?
  paidAt        String?
  payments      Payment[]

  @@unique([name])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

/**
 * 收款记录（Payment）
 * ================================================================================
 * 发票的分笔收款流水:哪天、收了多少、什么方式、冲哪张发票。
 * Invoice.amountPaid 为各笔 Payment 之和(由 /api/payments 在事务内维护)。
 */
model Payment {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customerId String
  amount     Decimal  @db.Decimal(12, 2)
  /// cash | transfer | other
  method     String   @default("transfer")
  paidAt     DateTime @default(now())
  note       String?
  createdBy  String?
  createdAt  DateTime @default(now())

  @@index([invoiceId])
  @@index([customerId])
  @@index([paidAt])
}

/**
 * 库存批次（Lot）
 * ================================================================================
 * 每次入库（采购收货、手动调整入库、退货入库）产生一个 Lot。
 * 报废/出库时关联到具体 Lot，实现先进先出追溯。
 */
model Lot {
  id         String    @id @default(cuid())
  /// 批号：LOT-00001
  lotNumber  String    @unique
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// 入库时的初始数量
  initialQty Decimal   @db.Decimal(14, 3)
  /// 当前剩余数量（入库后被报废/出库消耗后递减）
  currentQty Decimal   @db.Decimal(14, 3)
  /// 来源类型：GOODS_RECEIPT / PURCHASE_ORDER / ADJUSTMENT / RETURN
  sourceType String
  /// 来源单据 ID
  sourceId   String?
  /// 来源单据编号（如 GR-00001, PO-00003）
  sourceRef  String?
  /// 保质期（最佳食用日期）
  bestBefore DateTime?
  /// 批次日期（业务归属日期，对应 PO 的 expectedDate 或实际到货日）
  arrivedAt  DateTime  @default(now())
  /// 状态：AVAILABLE=有库存可用, DEPLETED=已耗尽
  status     String    @default("AVAILABLE")
  /// 参考单位下的单位成本（收货时从 PO 行 unitCost 写入；历史批次由 backfill-lot-cost 回填，回填不到为 null）
  unitCost   Decimal?  @db.Decimal(12, 4)
  createdAt  DateTime  @default(now())

  stockMoves StockMove[]

  @@index([productId])
  @@index([status])
  @@index([arrivedAt])
  @@index([sourceType, sourceId])
}

model StockMove {
  id          String        @id @default(cuid())
  productId   String
  productName String
  type        StockMoveType
  qty         Decimal       @db.Decimal(14, 3)
  note        String?
  /// 来源单据类型：SO / PO / RETURN / ADJUSTMENT / CREDIT_NOTE
  sourceType  String?
  /// 来源单据 ID
  sourceId    String?
  /// 来源单据编号（如 SO-00001, PO-00003）
  sourceRef   String?
  /// 关联批次（报废/出库时指向消耗的 Lot）
  lotId       String?
  lot         Lot?          @relation(fields: [lotId], references: [id])
  /// 损耗归因 · 环节（台账 D4/E4）：SORTING/TRANSPORT/STORAGE/RECEIPT/CUSTOMER_RETURN/OTHER。
  /// 只对 SCRAP 类流水有意义；历史行为 null，看板按原因反推展示（见 lib/loss-attribution.ts）
  lossStage   String?
  /// 损耗归因 · 原因（结构化，取值见 lib/scrap-reasons.ts）。
  /// 此前原因只存在 note 拼接串里，看板靠正则从文本里反解，改不动文案就会静默失真
  lossReason  String?
  /// 业务日期（库存批次归属日期）：采购入库=PO.expectedDate或GR.arrivedAt，销售出库=订单交付日，手动调整=操作日
  /// 与 createdAt（记录创建时间）分开，确保库存按实际业务日期归批
  movedAt     DateTime      @default(now())
  createdAt   DateTime      @default(now())

  @@index([productId])
  @@index([lotId])
  @@index([movedAt])
  @@index([createdAt])
  @@index([type])
  @@index([sourceType, sourceId])
  @@index([lossStage])
}

model PurchaseRecord {
  id          String   @id @default(cuid())
  productId   String
  productName String
  spec        String   @default("")
  quantity    Decimal  @db.Decimal(14, 3)
  unitCost    Decimal  @db.Decimal(12, 4)
  /// 外键指向 Customer(isVendor=true)；兼容老数据保留 supplier 文本
  supplierId  String?
  supplier    String
  arrivedAt   String
  createdAt   DateTime @default(now())

  @@index([productId])
  @@index([supplierId])
  @@index([createdAt])
}

enum ActionType {
  LOGIN
  CREATE
  UPDATE
  DELETE
}

model ActionLog {
  id         String     @id @default(cuid())
  userId     String
  userEmail  String
  userName   String
  action     ActionType
  resource   String
  resourceId String?
  detail     String?
  /// 字段级变更前后快照（JSON），例如 {"price":{"before":10,"after":12}}
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime   @default(now())

  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@index([action])
}

/**
 * 数据库备份任务记录 —— 每次自动/手动 pg_dump 备份留一条记录
 * status: running | success | failed
 * triggerType: AUTO（Cloud Scheduler 每日触发）| MANUAL（BOSS 在后台点击）
 */
model BackupJob {
  id           String    @id @default(cuid())
  status       String    @default("running")
  triggerType  String
  triggeredBy  String?
  gcsPath      String?
  sizeBytes    Int?
  errorMessage String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([status])
  @@index([startedAt])
}

/**
 * 采购订单（对应 Odoo purchase.order）
 * 从 RFQ → Sent → Confirmed → Received → Invoiced 完整工作流
 */
model PurchaseOrder {
  id                   String              @id @default(cuid())
  name                 String              @unique // PO-00001
  supplierId           String
  status               PurchaseOrderStatus @default(DRAFT)
  orderDate            DateTime            @default(now())
  /// 预计到货日期
  expectedDate         DateTime?
  /// 首次实际到货日（台账 E7）：第一张收货单的到货日，回答「供应商有没有按期**开始**交付」
  firstArrivedAt       DateTime?
  /// 最近一次实际到货日：分批收货取最后一批。收齐后它就是「收齐日」，准时率按它算
  lastArrivedAt        DateTime?
  /// 货币（默认与公司主币一致）
  currency             String              @default("EUR")
  /// 下单时锁定的 currency→EUR 当日汇率快照，事后汇率变动不影响历史单据；
  /// 非欧元且没能拿到有效汇率时为 null，此时 exchangeRatePending=true(20260713 汇率换算改造)
  exchangeRate         Decimal?            @default(1) @db.Decimal(14, 6)
  /// true=汇率是接口取不到时的占位状态(缺失)，需财务在采购单里补录后才能推进「确认」
  exchangeRatePending  Boolean             @default(false)
  /// 不含税总金额（原币）
  subtotalExTax        Decimal             @default(0) @db.Decimal(12, 2)
  totalTax             Decimal             @default(0) @db.Decimal(12, 2)
  totalIncTax          Decimal             @default(0) @db.Decimal(12, 2)
  /// 本单运费（税前，原币），按行 subtotal 占比摊入各行落地成本，不回写 Product 成本
  freightAmount        Decimal             @default(0) @db.Decimal(14, 2)
  /// 以下 *Eur 字段 = 原币字段 × exchangeRate（币种为 EUR 时恒等于原字段）；
  /// 下游(收货成本回写/供应商账单/会计分录)一律只读这些字段，不再各自乘汇率——
  /// exchangeRatePending 时为 null，因为汇率未知没法折算(20260713 汇率换算改造)
  subtotalExTaxEur     Decimal?            @db.Decimal(12, 2)
  totalTaxEur          Decimal?            @db.Decimal(12, 2)
  totalIncTaxEur       Decimal?            @db.Decimal(12, 2)
  freightAmountEur     Decimal?            @db.Decimal(14, 2)
  /// 用于识别/预填本单的供应商 PDF 原件
  sourceDocumentUrl    String?
  sourceDocumentName   String?
  /// 备注
  notes                String?
  createdBy            String?
  confirmedAt          DateTime?
  cancelledAt          DateTime?
  /// 锁定时间（LOCKED 状态时记录）
  lockedAt             DateTime?
  /// 编辑审批标记（CONFIRMED+ 状态下非安全字段被编辑时设置）
  editApprovalRequired Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]
  bills    VendorBill[]

  @@index([supplierId])
  @@index([status])
  @@index([orderDate])
}

/**
 * 采购订单行（对应 Odoo purchase.order.line）
 * 一个 PO 包含多条商品行，每行记录 orderedQty 和 receivedQty 分别。
 */
model PurchaseOrderLine {
  id                String        @id @default(cuid())
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId         String
  productName       String
  /// 采购 UoM ID（可空，兼容）
  uomId             String?
  /// 订购数量（采购 UoM 下）
  orderedQty        Decimal       @db.Decimal(14, 3)
  /// 已收数量（采购 UoM 下）
  receivedQty       Decimal       @default(0) @db.Decimal(14, 3)
  /// 已开票数量
  invoicedQty       Decimal       @default(0) @db.Decimal(14, 3)
  /// 采购 UoM 下的单价（原币）
  unitCost          Decimal       @db.Decimal(12, 4)
  /// 行税率
  taxRate           Decimal       @default(0) @db.Decimal(6, 4)
  subtotalExTax     Decimal       @db.Decimal(12, 2)
  taxAmount         Decimal       @db.Decimal(12, 2)
  subtotalIncTax    Decimal       @db.Decimal(12, 2)
  /// 折合欧元 = 原币字段 × PurchaseOrder.exchangeRate；收货成本回写 Product.standardPrice/
  /// Lot.unitCost 一律读这几个字段，不读上面原币字段。PO 汇率待确认时为 null(20260713)
  unitCostEur       Decimal?      @db.Decimal(12, 4)
  subtotalExTaxEur  Decimal?      @db.Decimal(12, 2)
  taxAmountEur      Decimal?      @db.Decimal(12, 2)
  subtotalIncTaxEur Decimal?      @db.Decimal(12, 2)
  /// 保质期（最佳食用日期）
  bestBefore        DateTime?
  sequence          Int           @default(10)
  createdAt         DateTime      @default(now())

  @@index([purchaseOrderId])
  @@index([productId])
  @@index([uomId])
}

/**
 * 收货单（对应 Odoo stock.picking type=incoming）
 * 一个 PO 可以产生多张 Receipt（分批到货）
 */
model GoodsReceipt {
  id              String        @id @default(cuid())
  name            String        @unique // GR-00001
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  /// 到货日期
  arrivedAt       DateTime
  /// 签收人
  receivedBy      String?
  /// JSON: [{productId, productName, qty, uomId, condition:'ok'|'damaged'|'rejected', bestBefore,
  ///         qc:{weightKg,freshness,pesticide,note,checkedBy,checkedAt}|null, rejectReason|null}]
  /// condition='rejected'（质检拒收）不入库、不建批次、不计 receivedQty；口径见 lib/purchase/qc.ts
  lines           Json          @default("[]")
  notes           String?
  /// 取证照片：base64 data URI 数组（复用司机退货证据照片同一套轻量存储方式，见 driver/trip/[id]/page.tsx）
  photos          String[]      @default([])
  createdAt       DateTime      @default(now())

  @@index([purchaseOrderId])
  @@index([arrivedAt])
}

/**
 * 会计科目（对应 Odoo account.account）
 * ================================================================================
 * code 通常是 4 位数字，例如：
 * 1100 Accounts Receivable (RECEIVABLE)
 * 2100 Accounts Payable (PAYABLE)
 * 2200 VAT Payable (LIABILITY)
 * 4000 Sales Revenue (INCOME)
 * 5000 Cost of Goods Sold (EXPENSE)
 * 1200 Bank (ASSET)
 */
model Account {
  id          String             @id @default(cuid())
  code        String             @unique
  name        String
  nameZh      String?
  type        AccountType
  active      Boolean            @default(true)
  /// 是否接受手动过账；false 表示只通过系统自动生成（如 AR/AP）
  allowManual Boolean            @default(false)
  createdAt   DateTime           @default(now())
  lines       JournalEntryLine[]

  @@index([type])
  @@index([active])
}

/**
 * 日记账凭证（Odoo account.move）
 * ================================================================================
 * 一张凭证 = 一个完整的双式记账事件。必须满足 Σdebit = Σcredit。
 * 来源事件包括：发票过账 / 收款 / 供应商账单 / 付款 / 手动调整。
 */
model JournalEntry {
  id          String             @id @default(cuid())
  name        String             @unique // JE-00001
  date        DateTime           @default(now())
  narration   String // 简要说明
  /// 来源类型：invoice / vendor_bill / payment / manual
  sourceType  String?
  /// 来源单据 ID
  sourceId    String?
  status      JournalEntryStatus @default(DRAFT)
  totalDebit  Decimal            @default(0) @db.Decimal(14, 2)
  totalCredit Decimal            @default(0) @db.Decimal(14, 2)
  createdBy   String?
  postedAt    DateTime?
  createdAt   DateTime           @default(now())

  lines JournalEntryLine[]

  @@index([date])
  @@index([sourceType, sourceId])
  @@index([status])
}

/**
 * 凭证行（Odoo account.move.line）
 * debit / credit 至少有一个为 0；两者之和 > 0
 */
model JournalEntryLine {
  id          String       @id @default(cuid())
  entryId     String
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account      @relation(fields: [accountId], references: [id])
  description String?
  /// 借方金额
  debit       Decimal      @default(0) @db.Decimal(14, 2)
  /// 贷方金额
  credit      Decimal      @default(0) @db.Decimal(14, 2)
  /// 关联的合作伙伴（客户/供应商）
  partnerId   String?
  sequence    Int          @default(10)

  @@index([entryId])
  @@index([accountId])
  @@index([partnerId])
}

/**
 * 供应商账单（Odoo account.move type=in_invoice）
 * 一个 PO 可以收到多张账单；账单金额 ≤ PO 金额
 */
/**
 * 供应商付款流水（台账 G2）
 * ================================================================================
 * 与客户侧的 `Payment` 严格对称。此前应付侧只有 `VendorBill.amountPaid` 一个**累计数字**：
 * 余额能递减，但「分了几笔、哪天付的、谁付的、什么方式」全查不到，也无法对账。
 * 而且前端是 read-modify-write（读到已付 100 → 传 100+50），两个人同时付会静默丢一笔。
 * 所以付款一律走这张流水表，`amountPaid` 退化为它的汇总（db:validate 有对应不变量）。
 */
model VendorPayment {
  id           String     @id @default(cuid())
  vendorBillId String
  vendorBill   VendorBill @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)
  supplierId   String
  /// 本笔付款金额（欧元）。负数表示冲销/退款
  amount       Decimal    @db.Decimal(12, 2)
  /// bank | cash | other
  method       String     @default("bank")
  paidAt       DateTime   @default(now())
  note         String?
  createdBy    String?
  createdAt    DateTime   @default(now())

  @@index([vendorBillId])
  @@index([supplierId])
  @@index([paidAt])
}

model VendorBill {
  id              String           @id @default(cuid())
  name            String           @unique
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  supplierId      String
  billDate        DateTime         @default(now())
  dueDate         DateTime?
  lines           Json             @default("[]")
  /// 币种/汇率快照，跟随来源采购单，仅用于财务核对原始外币发票；下面的金额字段
  /// (subtotalExTax 等)始终存欧元折算值，会计过账(lib/accounting.ts)直接读这几个字段即可(20260713)
  currency        String           @default("EUR")
  exchangeRate    Decimal?         @default(1) @db.Decimal(14, 6)
  subtotalExTax   Decimal          @default(0) @db.Decimal(12, 2)
  totalTax        Decimal          @default(0) @db.Decimal(12, 2)
  totalIncTax     Decimal          @default(0) @db.Decimal(12, 2)
  amountPaid      Decimal          @default(0) @db.Decimal(12, 2)
  amountDue       Decimal          @default(0) @db.Decimal(12, 2)
  status          VendorBillStatus @default(DRAFT)
  notes           String?
  createdAt       DateTime         @default(now())
  postedAt        DateTime?
  paidAt          DateTime?

  payments VendorPayment[]

  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([status])
  @@index([billDate])
}

/**
 * 司机配送批次配置
 * timeOfDay: "am" | "pm"，batchNum: 1-5
 * 合并为 deliveryBatch 字符串格式 "1 am BAO"
 */
model DriverSlot {
  id         String   @id @default(cuid())
  timeOfDay  String // "am" | "pm"
  batchNum   Int // 1-5
  driverName String
  /// 绑定的系统 DRIVER 用户(SSOT P0-2/A2):配送出发建 Trip 时以此为 driverId,
  /// 司机端按 userId 查自己的行程。driverName 仅作显示快照,身份以 userId 为准。
  userId     String?
  driverUser User?    @relation("DriverSlotUser", fields: [userId], references: [id], onDelete: SetNull)
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders           Order[]
  defaultCustomers Customer[] @relation("CustomerDefaultSlot")

  @@unique([timeOfDay, batchNum, driverName])
  @@index([userId])
}

/// 采购建议（P0-2：系统根据需求-库存自动生成）
model PurchaseSuggestion {
  id               String    @id @default(cuid())
  tenantId         String    @default("test-company")
  productId        String
  productName      String
  currentStock     Decimal   @default(0) @db.Decimal(14, 3)
  demandQty        Decimal   @default(0) @db.Decimal(14, 3)
  suggestedQty     Decimal   @default(0) @db.Decimal(14, 3)
  supplierId       String?
  supplierName     String?
  estimatedCost    Decimal?  @db.Decimal(12, 2)
  /// 优先级：critical / high / normal / low
  priority         String    @default("normal")
  /// 状态：pending / approved / rejected / ordered
  status           String    @default("pending")
  purchaseOrderId  String?
  generatedAt      DateTime  @default(now())
  resolvedAt       DateTime?
  resolvedBy       String?
  /// 该商品归属的采购品类分组 key（冗余存储,避免每次列表查询都要多级 join），可空=未映射分组
  categoryGroupKey String?
  /// 生成依据的说明文案，如"近3日出货均值+未来订单"/"已确认订单缺口"，用于 UI 展示"为什么建议采购"
  reason           String?
  /// 以下四列仅生鲜次日备货(FRESH_FROZEN)生成时才写入，供前端拆分展示；其余品类生成路径留空
  dailyAvgOutbound Decimal?  @db.Decimal(14, 3)
  futureDemand     Decimal?  @db.Decimal(14, 3)
  inTransitQty     Decimal?  @db.Decimal(14, 3)
  uomName          String?

  @@index([productId])
  @@index([status])
  @@index([generatedAt])
  @@index([categoryGroupKey])
  @@index([supplierId])
  @@index([purchaseOrderId])
}

/// 通知（P1-11：缺货自动通知等）
model Notification {
  id        String   @id @default(cuid())
  tenantId  String   @default("test-company")
  userId    String
  /// 通知类型：shortage / order_update / system
  type      String
  title     String
  body      String
  data      Json     @default("{}")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

/// 财务对账单（P1-1：按客户、周期汇总应收应付）
model Statement {
  id             String    @id @default(cuid())
  tenantId       String    @default("test-company")
  customerId     String
  customerName   String
  periodStart    DateTime  @db.Date
  periodEnd      DateTime  @db.Date
  openingBalance Decimal   @default(0) @db.Decimal(12, 2)
  totalSales     Decimal   @default(0) @db.Decimal(12, 2)
  totalPayments  Decimal   @default(0) @db.Decimal(12, 2)
  closingBalance Decimal   @default(0) @db.Decimal(12, 2)
  orderIds       String[]  @default([])
  invoiceIds     String[]  @default([])
  /// 状态：draft / confirmed / sent
  status         String    @default("draft")
  createdAt      DateTime  @default(now())
  sentAt         DateTime?

  @@index([customerId])
  @@index([status])
  @@index([periodStart])
}

/// 贷记单 / Credit Note（P0-3：退货退款凭证，支持跨单合并）
model CreditNote {
  id            String           @id @default(cuid())
  name          String           @unique
  customerId    String
  customerName  String
  creditDate    DateTime         @default(now())
  currency      String           @default("EUR")
  subtotalExTax Decimal          @default(0) @db.Decimal(12, 2)
  totalTax      Decimal          @default(0) @db.Decimal(12, 2)
  totalIncTax   Decimal          @default(0) @db.Decimal(12, 2)
  /// 状态：DRAFT / CONFIRMED / APPLIED / CANCELLED
  status        String           @default("DRAFT")
  notes         String?
  createdBy     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  lines         CreditNoteLine[]

  @@index([customerId])
  @@index([status])
  @@index([creditDate])
}

/// 贷记单行项（退款明细，包含来源订单/行程引用）
model CreditNoteLine {
  id             String     @id @default(cuid())
  creditNoteId   String
  creditNote     CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  productId      String
  productName    String
  quantity       Decimal    @db.Decimal(14, 3)
  unitPrice      Decimal    @default(0) @db.Decimal(12, 2)
  taxRate        Decimal    @default(0) @db.Decimal(6, 4)
  subtotalExTax  Decimal    @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal    @default(0) @db.Decimal(12, 2)
  subtotalIncTax Decimal    @default(0) @db.Decimal(12, 2)
  reason         String?
  /// 来源销售订单 ID
  sourceOrderId  String?
  /// 来源行程 ID
  sourceTripId   String?
  sequence       Int        @default(0)
  createdAt      DateTime   @default(now())

  @@index([creditNoteId])
  @@index([productId])
  @@index([sourceOrderId])
  @@index([sourceTripId])
}

/// 盘点单状态
enum StockTakeStatus {
  DRAFT
  DONE
  CANCELLED
}

/**
 * 库存盘点单（Stock Take）
 * ================================================================================
 * 建单时对选中商品快照 systemQty；录入实盘 countedQty；完成时对 diff ≠ 0 的行
 * 生成 StockMove(type=ADJUSTMENT, sourceType='STOCK_TAKE') 并同步 Product.qtyOnHand。
 */
model StockTake {
  id        String          @id @default(cuid())
  /// 编号：STK-00001
  name      String          @unique
  status    StockTakeStatus @default(DRAFT)
  /// 盘点业务日期
  takenAt   DateTime
  /// 创建人（姓名快照，与 GoodsReceipt.receivedBy 同风格）
  createdBy String?
  notes     String?
  lines     StockTakeLine[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([status])
  @@index([takenAt])
}

model StockTakeLine {
  id          String    @id @default(cuid())
  stockTakeId String
  stockTake   StockTake @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  productId   String
  productName String
  /// 建单时系统库存快照
  systemQty   Decimal   @db.Decimal(14, 3)
  /// 实盘数量（未录入为 null）
  countedQty  Decimal?  @db.Decimal(14, 3)
  /// countedQty − systemQty（完成时固化）
  diffQty     Decimal?  @db.Decimal(14, 3)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([stockTakeId])
  @@index([productId])
}

/**
 * 每日经营快照（数据分析中心地基）
 * ================================================================================
 * 惰性生成（打开分析中心补齐缺失日期，幂等 upsert）；当天实时算不写快照；
 * 订正数据后通过 POST /api/analytics/snapshots 重算。口径见 lib/analytics/metrics.ts。
 */
model DailyBusinessSnapshot {
  id               String   @id @default(cuid())
  snapshotDate     DateTime @unique @db.Date
  /// 销售额（税前，销售口径 = confirmationDate）
  salesExTax       Decimal  @default(0) @db.Decimal(14, 2)
  /// 销售额（税后）
  salesIncTax      Decimal  @default(0) @db.Decimal(14, 2)
  /// 毛利（税前）
  grossProfit      Decimal  @default(0) @db.Decimal(14, 2)
  /// 实际批次成本覆盖率 0~1
  costCoverageRate Decimal  @default(0) @db.Decimal(6, 4)
  orderCount       Int      @default(0)
  activeCustomers  Int      @default(0)
  /// 缺货行数（物流口径）
  shortageLines    Int      @default(0)
  /// 订单行数（物流口径，缺货率分母）
  orderLines       Int      @default(0)
  /// 退货额（税前）
  creditNoteAmount Decimal  @default(0) @db.Decimal(14, 2)
  /// 损耗额（SCRAP + 盘亏，按成本计）
  scrapAmount      Decimal  @default(0) @db.Decimal(14, 2)
  /// 采购额（税前，按 PO 确认日）
  purchaseExTax    Decimal  @default(0) @db.Decimal(14, 2)
  /// 当日应收余额快照（POSTED 且 amountDue > 0）
  arBalance        Decimal  @default(0) @db.Decimal(14, 2)
  /// 其中已逾期部分
  arOverdue        Decimal  @default(0) @db.Decimal(14, 2)
  /// 快照生成时间（订正后重算会更新）
  computedAt       DateTime @default(now())

  @@index([snapshotDate])
}

// ============================================================================
// 可配置权限体系（20260807）
// 设计：docs/20260807-rbac-configurable-design-and-tasks.md
//
// 权限点的唯一真相是 lib/rbac/catalog.ts，下面的 Permission 表只是它的镜像，
// 由 scripts/rbac/sync-permissions.ts 在部署时同步。
// enum Role 保留为兼容层（旧 token、旧代码路径），判定真相是 AppRole.permissions。
// ============================================================================

/// 角色能看到谁的数据。多角色账号取最宽的一档。
enum DataScope {
  /// 全部数据
  ALL
  /// 自己 + 直属下属（User.managerId 一层）
  TEAM
  /// 只有自己名下的
  OWN
}

/// 可配置角色。预置的 12 个 isSystem=true，不可删除但权限可改。
model AppRole {
  id          String    @id @default(cuid())
  /// 稳定标识，代码里引用用它（预置角色即原 Role 枚举值的小写形式）
  code        String    @unique
  name        String
  description String?
  /// 预置角色：不可删除（删了会让平迁基线失效），权限可改
  isSystem    Boolean   @default(false)
  dataScope   DataScope @default(ALL)
  /// 权限点 id 列表，取值必须存在于 lib/rbac/catalog.ts
  permissions String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users UserRoleLink[]

  @@index([isSystem])
}

/// 用户 ↔ 角色（多对多）
model UserRoleLink {
  userId String
  roleId String

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

/// 个人级权限例外。granted=true 加权限，false 扣权限。
/// 用途：「办公室销售里只有张三能进配送中心」—— 不必为此再造一个角色。
model UserPermissionGrant {
  userId       String
  /// 权限点 id，取值必须存在于 lib/rbac/catalog.ts
  permissionId String
  granted      Boolean
  /// 谁给的、为什么给 —— 权限例外最容易变成无人知晓的后门
  grantedBy    String?
  reason       String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId])
}

/// lib/rbac/catalog.ts 的数据库镜像，供配置页展示。⛔ 页面不可增删，只能由同步脚本写入。
model Permission {
  id      String @id
  module  String
  action  String
  labelZh String
  labelEn String
  /// 位图序号，与 lib/rbac/sortkeys.json 冻结值一致
  sortKey Int

  @@index([module])
}

/// 司机每日回传（台账 C8）：司机收车时提交当日的现金 / 订单总额 / 退货数 / 换货数。
///
/// ⛔ **这张表只存"提交那一刻的快照"，不是这四个数字的真相**。
/// 真相仍在 Trip 上（cashCollected / totalPayment / restaurants[].returns[]），
/// 查询时实时派生。存快照是为了回答「司机当时报的是多少」——
/// 提交之后行程被改（退货审核、补录收款），快照与实时值就会不一样，
/// 那个差额正是对账要看见的东西，抹平它等于把对账做没了。
/// 与 H3 的「冻结提成 vs 重算提成」是同一个模式。
model DriverDailyReport {
  id         String   @id @default(cuid())
  /// 司机的系统账号（User.id）——与 Trip.driverId 同一实体，见 C6 的单一真相约束
  driverId   String
  driver     User     @relation("DriverDailyReports", fields: [driverId], references: [id], onDelete: Cascade)
  /// 业务日（都柏林时区的自然日），与波次 waveDate 同口径
  reportDate DateTime @db.Date

  /// ── 提交时刻的四项快照 ──
  cashCollected Decimal  @db.Decimal(12, 2)
  orderTotal    Decimal  @db.Decimal(12, 2)
  returnCount   Int
  exchangeCount Int
  /// 这份日报覆盖了哪几趟行程，用于事后追溯"当时算的是哪些单"
  tripIds       String[]

  note            String?
  status          String    @default("submitted") /// submitted | confirmed（confirmed 由 C9 财务确认写入）
  submittedAt     DateTime  @default(now())
  submittedById   String
  submittedByName String
  confirmedAt     DateTime?
  confirmedById   String?
  confirmedByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ⛔ 防重复提交靠**数据库唯一约束**，不靠应用层先查后写 ——
  /// 后者在并发下必然漏（G2 的分批付款就是这么丢过钱的）
  @@unique([driverId, reportDate])
  @@index([reportDate])
  @@index([status])
}

enum BulletinCategory {
  /// 缺货
  SHORTAGE
  /// 到货
  ARRIVAL
  /// 供应商调价 —— 内容层面禁止出现具体金额，属产品规则，非数据库约束
  PRICE_CHANGE
  OTHER
}

enum BulletinSource {
  /// 同事手动发布
  MANUAL
  /// 系统自动生成（Phase 2 才会真正写入，本轮先把枚举建好避免二次迁移）
  AUTO
}

/// 信息广场：把原来发在微信群里的"缺货了/到货了/调价了"这类内部消息沉淀下来，
/// 可搜索、可置顶，不做点赞/评论——是布告栏，不是论坛。
model BulletinPost {
  id       String           @id @default(cuid())
  category BulletinCategory
  source   BulletinSource   @default(MANUAL)
  content  String           @db.Text
  imageUrl String?

  /// AUTO 来源的帖子没有人类作者，故可空
  authorId String?
  author   User?  @relation("BulletinPostAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  pinned         Boolean   @default(false)
  pinnedAt       DateTime?
  pinnedByUserId String?
  pinnedBy       User?     @relation("BulletinPostPinnedBy", fields: [pinnedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([category, createdAt])
  @@index([pinned, createdAt])
}
