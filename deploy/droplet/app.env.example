# 照这个写服务器上的 /etc/veggie/app.env
#   属主 veggie:veggie，chmod 600 —— deploy 用户读不到明文密钥
#   （容器由 root 的 dockerd 启动，不需要 deploy 能读）
#
# ⛔ 本文件是模板，不要把真实值填进来提交到 git。

# ── 数据库 ───────────────────────────────────────────────────────────────────
# 走宿主机 PostgreSQL 的 unix socket，数据库配 listen_addresses='' 完全不监听网络
DATABASE_DRIVER=pg
DATABASE_URL=postgresql://veggie@localhost/veggie?host=/var/run/postgresql

# ── 存储 ─────────────────────────────────────────────────────────────────────
# 上传文件落本地磁盘，由 Nginx alias 直出，不经 Node
STORAGE_DRIVER=local
UPLOAD_DIR=/data/uploads

# 备份落点。B3（DO Spaces 桶 + 凭据）到位前先用 local，到位后改 s3 并补 S3_*。
# ⚠️ 合同要求「至少一份备份保存在不同于主服务器的位置」——只用 local 不满足该条款。
BACKUP_DRIVER=local
BACKUP_LOCAL_DIR=/data/backups
# BACKUP_DRIVER=s3
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://fra1.digitaloceanspaces.com
# S3_REGION=fra1

# ── 密钥 ─────────────────────────────────────────────────────────────────────
# ⛔ JWT_SECRET 必须与现生产（Cloud Run 的 VEGGIE_JWT_SECRET）**完全一致**，
#    否则切换瞬间所有已登录用户被登出。这是最容易漏、用户体感最强的一条。
JWT_SECRET=

# 备份定时任务用。新生成即可，与现生产无需一致。
# 注意路由校验的 header 是 x-cron-secret，不是 Authorization: Bearer。
CRON_SECRET=

# ── 与主机无关的 SaaS（迁移后照常可用，部署铁律豁免）────────────────────────
RESEND_API_KEY=
# 发件地址。⛔ 这里的域名必须先在 Resend 后台「加域」并把 SPF/DKIM 记录配进 DNS，
# 否则发信 API 恒返回 403，一封都发不出去。2026-08-08 实测 veggiesupply.ie 和
# johnstonebros.ie 当时都未验证 —— 订单确认 / 密码重置 / 采购 RFQ 三处全是哑的。
# 留空回退到 Johnstone Bros <noreply@johnstonebros.ie>。
EMAIL_FROM=
NEXT_PUBLIC_SENTRY_DSN=
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── 不要配的 ────────────────────────────────────────────────────────────────
# GCS_BUCKET_NAME / GCS_BACKUP_BUCKET_NAME —— GCS 是遗留 driver，私有化下不可用
