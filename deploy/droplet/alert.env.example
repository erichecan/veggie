# /etc/veggie/alert.env —— root:root 0600
#
# ⛔ 本文件被 alert.sh 以 `. ` 引入，是 shell 语法，不是 dotenv。
#    所有值必须加引号 —— ALERT_FROM 里的 `<` `>` 不加引号会被当成重定向，
#    导致整个文件解析中断，后面的变量一个都读不到（实测踩过）。

# ⛔ 待填：GCP Secret Manager 里 VEGGIE_RESEND_API_KEY 的值是字面量 "placeholder"，不是真 key
RESEND_API_KEY=""

ALERT_TO="szahua@gmail.com"
ALERT_FROM="VeggieSupply Ops <noreply@veggiesupply.ie>"

MEM_THRESHOLD_MB="400"      # 可用内存低于此值告警
DISK_THRESHOLD_PCT="80"     # 根分区使用率高于此值告警
SWAP_THRESHOLD_PCT="50"     # swap 使用率高于此值告警（swap 被用起来 = 内存已吃紧）

# 同类告警的重复提醒间隔，默认 6 小时，避免每 5 分钟刷一封
# REPEAT_AFTER_SEC="21600"
