#!/usr/bin/env bash
# 仓库级 pre-commit 防护（c-d17237 事件后新增）
#
# 背景：2026-08 发现本仓库曾以 public 状态暴露 pic/ 目录下的真实客户 Odoo 导出
# （res.partner.csv、sale.order.csv、发票 PDF 等）。为防止再次把类似 PII 文件提交
# 入库，本 hook 在 commit 前扫描暂存区，命中以下任一规则则阻断提交：
#
#   1) 文件名/路径匹配已知 PII 文件模式（res.partner / sale.order / crm.team /
#      product.pricelist / product.product 等 Odoo 导出命名，或 pic/ 目录下的
#      csv/xlsx/xls/sql/pdf）。
#   2) 新增内容中出现明显的邮箱或电话号码样式文本（粗粒度启发式，宁可误报）。
#
# 启用方式：本仓库通过 package.json 的 "prepare" 脚本在 `npm install` 时自动执行
#   git config core.hooksPath .githooks
# 也可以手动执行同一条命令启用。
#
# 误报时的绕过方式（仅限确认过内容已脱敏 / 确实不是 PII 时使用）：
#   git commit --no-verify

set -euo pipefail

staged_files=$(git diff --cached --name-only --diff-filter=ACM || true)

if [ -z "$staged_files" ]; then
  exit 0
fi

blocked=0

# --- 规则 1：已知 PII 文件命名 / 危险目录 -----------------------------------
pii_name_pattern='(res\.partner|sale\.order|crm\.team|product\.pricelist|product\.product)|(^|/)pic/.*\.(csv|xlsx|xls|sql|pdf)$'

while IFS= read -r f; do
  [ -z "$f" ] && continue
  if echo "$f" | grep -Eiq "$pii_name_pattern"; then
    echo "⛔ [pre-commit] 疑似客户数据导出文件，禁止提交: $f"
    echo "   命中规则：文件名/路径匹配已知 Odoo PII 导出模式（参见 c-d17237 事件）。"
    blocked=1
  fi
done <<< "$staged_files"

# --- 规则 2：新增内容中的邮箱 / 电话号码样式文本 -----------------------------
email_pattern='[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}'
phone_pattern='[+][0-9]{1,3}[- ]?[0-9]{2,4}[- ]?[0-9]{3,4}[- ]?[0-9]{3,4}'

while IFS= read -r f; do
  [ -z "$f" ] && continue
  # 跳过已被规则1拦截的文件，避免重复报告；也跳过二进制/图片，避免误报噪音
  case "$f" in
    *.png|*.jpg|*.jpeg|*.gif|*.webp|*.ico|*.lock|package-lock.json|pnpm-lock.yaml|yarn.lock)
      continue
      ;;
  esac

  added_lines=$(git diff --cached -U0 -- "$f" | grep -E '^\+' | grep -Ev '^\+\+\+' || true)
  [ -z "$added_lines" ] && continue

  if echo "$added_lines" | grep -Eq "$email_pattern"; then
    echo "⛔ [pre-commit] 新增内容含疑似邮箱地址，禁止提交: $f"
    blocked=1
  fi
  if echo "$added_lines" | grep -Eq "$phone_pattern"; then
    echo "⛔ [pre-commit] 新增内容含疑似电话号码，禁止提交: $f"
    blocked=1
  fi
done <<< "$staged_files"

if [ "$blocked" -eq 1 ]; then
  echo ""
  echo "如确认以上文件不含真实客户 PII（例如已脱敏的示例数据），可用 git commit --no-verify 绕过。"
  echo "如不确定，请先咨询后再提交（参考 docs/20260819-veggie-PII处置方案.md）。"
  exit 1
fi

exit 0
